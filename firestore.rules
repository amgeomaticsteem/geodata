rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null && request.auth.token.email == 'refathany2005@gmail.com';
    }
    function signedIn() { return request.auth != null; }
    function validResource(data) {
      return data.resourceCol in ['projects', 'courses', 'programs', 'sites']
        && data.resourceId is string
        && data.resourceId.size() > 0;
    }
    function ownerMatches(data) {
      return data.ownerUid == ''
        || get(/databases/$(database)/documents/$(data.resourceCol)/$(data.resourceId)).data.publisherUid == data.ownerUid;
    }

    match /{col}/{id} {
      allow read: if col in ['projects', 'courses', 'programs', 'sites'];
      allow write: if isAdmin() && col in ['projects', 'courses', 'programs', 'sites'];
    }

    match /submissions/{id} {
      allow create: if signedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.status == 'pending';
      allow read: if isAdmin() || (signedIn() && resource.data.uid == request.auth.uid);
      allow update, delete: if isAdmin();
    }

    // One editable review per user/resource. Resource owner is checked
    // against the actual published catalog item, not trusted from the client.
    match /reviews/{reviewId} {
      allow read: if true;
      allow create: if signedIn()
        && request.resource.data.uid == request.auth.uid
        && validResource(request.resource.data)
        && ownerMatches(request.resource.data)
        && request.resource.data.resourceKey is string
        && request.resource.data.rating is int
        && request.resource.data.rating >= 1
        && request.resource.data.rating <= 5
        && request.resource.data.comment is string
        && request.resource.data.comment.size() <= 1200;
      allow update: if signedIn()
        && resource.data.uid == request.auth.uid
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.resourceKey == resource.data.resourceKey
        && request.resource.data.resourceCol == resource.data.resourceCol
        && request.resource.data.resourceId == resource.data.resourceId
        && request.resource.data.ownerUid == resource.data.ownerUid
        && validResource(request.resource.data)
        && ownerMatches(request.resource.data)
        && request.resource.data.rating is int
        && request.resource.data.rating >= 1
        && request.resource.data.rating <= 5
        && request.resource.data.comment is string
        && request.resource.data.comment.size() <= 1200;
      allow delete: if isAdmin() || (signedIn() && resource.data.uid == request.auth.uid);
    }

    match /notifications/{notificationId} {
      allow read: if signedIn() && resource.data.toUid == request.auth.uid;
      allow create: if signedIn()
        && request.resource.data.fromUid == request.auth.uid
        && request.resource.data.toUid is string
        && request.resource.data.toUid != request.auth.uid
        && request.resource.data.reviewId is string
        && exists(/databases/$(database)/documents/reviews/$(request.resource.data.reviewId))
        && get(/databases/$(database)/documents/reviews/$(request.resource.data.reviewId)).data.uid == request.auth.uid
        && get(/databases/$(database)/documents/reviews/$(request.resource.data.reviewId)).data.ownerUid == request.resource.data.toUid;
      allow update: if signedIn()
        && resource.data.toUid == request.auth.uid
        && request.resource.data.toUid == resource.data.toUid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read']);
      allow delete: if isAdmin();
    }

    match /reports/{reportId} {
      allow create: if signedIn()
        && request.resource.data.reporterUid == request.auth.uid
        && request.resource.data.status == 'new'
        && request.resource.data.reason is string
        && request.resource.data.reason.size() >= 3
        && request.resource.data.reason.size() <= 1200
        && request.resource.data.resourceKey is string
        && request.resource.data.resourceCol in ['projects', 'courses', 'programs', 'sites'];
      allow read, update, delete: if isAdmin();
    }
  }
}
