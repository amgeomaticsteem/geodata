rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null && request.auth.token.email == 'refathany2005@gmail.com';
    }
    // Public content: anyone can read, ONLY the admin can write
    match /{col}/{id} {
      allow read: if col in ['projects', 'courses', 'programs', 'sites'];
      allow write: if isAdmin() && col in ['projects', 'courses', 'programs', 'sites'];
    }
    // Submissions: signed-in users create pending items and read only their own; the admin reviews
    match /submissions/{id} {
      allow create: if request.auth != null && request.resource.data.uid == request.auth.uid && request.resource.data.status == 'pending';
      allow read: if isAdmin() || (request.auth != null && resource.data.uid == request.auth.uid);
      allow update, delete: if isAdmin();
    }
  }
}
